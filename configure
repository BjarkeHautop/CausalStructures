#!/bin/sh
# Compiles CausalStructures.jl into the shared library the package calls
# (inst/csjl), using the Julia found on the PATH or named by $JULIA. This takes
# a few minutes the first time, while Julia downloads and compiles the
# CausalStructures.jl dependencies.

: "${JULIA:=julia}"

# R puts its own library directories on LD_LIBRARY_PATH, which overrides the
# RUNPATH of Julia's bundled tools and makes e.g. Pkg's zstd load the system
# libzstd instead of Julia's.
unset LD_LIBRARY_PATH

if ! command -v "$JULIA" >/dev/null 2>&1; then
  echo "ERROR: CausalStructures needs Julia (>= 1.13) to install." >&2
  echo "Install it from https://julialang.org/install/, or set JULIA to the" >&2
  echo "path of a julia binary." >&2
  exit 1
fi

if ! "$JULIA" --startup-file=no -e 'VERSION >= v"1.13" || exit(1)'; then
  echo "ERROR: CausalStructures needs Julia >= 1.13, but $JULIA is" >&2
  "$JULIA" --startup-file=no -v >&2
  echo "With juliaup: juliaup add 1.13, then set JULIA to its julia binary." >&2
  exit 1
fi

echo "Compiling CausalStructures.jl with $JULIA ..."
if ! "$JULIA" --startup-file=no tools/csjl/build.jl inst/csjl; then
  echo "ERROR: compiling CausalStructures.jl failed." >&2
  exit 1
fi
